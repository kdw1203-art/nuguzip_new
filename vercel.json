{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "STRICT_ENV_CHECK=1 npm run build",
  "regions": [
    "icn1"
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "m.nuguzip.com"
        }
      ],
      "destination": "https://nuguzip.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/site-probe",
      "schedule": "15 */6 * * *"
    },
    {
      "path": "/api/cron/social-autopost",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/social-upload-drain",
      "schedule": "20 2 * * *"
    },
    {
      "path": "/api/cron/molit-transactions-ingest",
      "schedule": "40 0 * * *"
    },
    {
      "path": "/api/cron/reb-ingest",
      "schedule": "50 0 * * *"
    },
    {
      "path": "/api/cron/kb-ingest",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/complex-crawl",
      "schedule": "10 1 * * *"
    },
    {
      "path": "/api/cron/geocode-complexes?limit=200",
      "schedule": "20 1 * * *"
    },
    {
      "path": "/api/cron/apt-detail-enrich?limit=100",
      "schedule": "30 1 * * *"
    }
  ]
}
